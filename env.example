# Example environment file (DO NOT COMMIT real secrets)
#
# Copy to .env for local dev:
#   cp env.example .env
#
# IMPORTANT:
# - Never commit .env
# - Rotate any token that has been pasted into chat/logs

# MongoDB
MONGODB_URI=

# Auth
JWT_SECRET=
JWT_REFRESH_SECRET=

# Redis (ioredis) - AUTHORITATIVE for likes, rate limits, idempotency, sessions, queues
# Contabo / local: redis://127.0.0.1:6379 (bind Redis to 127.0.0.1 only)
# Cloud: redis://username:password@host:port
REDIS_URL=redis://127.0.0.1:6379

# PM2 cluster / multiple API instances — broadcast socket events across workers
# SOCKET_REDIS_ADAPTER=true

# Integration tests (local only — never point at production):
# RUN_INTEGRATION=1
# TEST_MONGODB_URI=mongodb://127.0.0.1:27017/jevah_like_test
# TEST_REDIS_URL=redis://127.0.0.1:6379
# Optional tighter limits while testing 429:
# LIKE_RATE_LIMIT_PER_CONTENT=3

# Session Management
# If not set, will use JWT_SECRET
SESSION_SECRET=

# Upstash Redis (REST) - optional non-critical caches ONLY (not like hot path)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

