# Example environment file (DO NOT COMMIT real secrets)
#
# Copy to .env for local dev:
#   cp env.example .env
#
# IMPORTANT:
# - Never commit .env
# - Rotate any token that has been pasted into chat/logs

# MongoDB
MONGODB_URI=

# Auth (must match mobile + Next admin / marketing app)
JWT_SECRET=
JWT_REFRESH_SECRET=

# Email (Resend) — verification, password reset, admin blast, marketing, moderation notices
RESEND_API_KEY=
# From address (either var works; ADMIN_EMAIL_FROM is the Next-app name)
RESEND_FROM_EMAIL=Jevah <noreply@jevahapp.com>
# ADMIN_EMAIL_FROM=Jevah <noreply@jevahapp.com>

# Public web origin for marketing unsubscribe links (prefer this over API URL)
# PUBLIC_WEB_URL=https://jevahapp.com
# FRONTEND_URL=http://localhost:3000
# APP_PUBLIC_URL=https://jevahapp.com
# Optional API base if you want unsubscribe links to hit the API directly:
# API_BASE_URL=https://api.jevahapp.com

# Web CORS (browser Origin must match). Comma-separated extra origins.
# Next.js admin/marketing (default port 3000) + Vite admin + production hosts:
# Example: ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://admin.jevahapp.com,https://jevahapp.com
# Next: set NEXT_PUBLIC_API_URL=https://api.jevahapp.com (or http://localhost:<api-port>)
# If NODE_ENV=production on a laptop but you still need LAN Vite/Expo/Next web:
# ALLOW_DEV_CORS=true

# Engagement anti-farming (Redis). CF view/like/share/save use these.
# VIEW_RATE_LIMIT_PER_CONTENT=20
# VIEW_RATE_WINDOW_PER_CONTENT_SECONDS=60
# VIEW_RATE_LIMIT_PER_USER=120
# LIKE_RATE_LIMIT_PER_CONTENT=4
# LIKE_RATE_LIMIT_PER_USER=60
# SHARE_RATE_LIMIT_PER_CONTENT=10
# SHARE_RATE_LIMIT_PER_USER=30

# Master / super-admin (web console). Password is NEVER committed — pass at seed time only.
# SUPER_ADMIN_EMAIL=support@jevahapp.com
# SUPER_ADMIN_PASSWORD=  # set in shell when running: npm run seed:super-admin
# MASTER_ADMIN_EMAIL=    # alias for SUPER_ADMIN_EMAIL (optional)

# Redis (ioredis) — BullMQ REQUIRES Redis ≥ 5.0
# Windows MSOpenTech Redis 3.0.504 on :6379 is NOT compatible — use C:\Redis5 on :6380,
# Memurai, Docker redis:7, Contabo, or Upstash redis:// / rediss:// URL.
# Upstash TLS: MUST use rediss:// (plain redis:// causes endless ECONNRESET).
REDIS_URL=redis://127.0.0.1:6380

# PM2 cluster / multiple API instances — broadcast socket events across workers
# SOCKET_REDIS_ADAPTER=true

# Integration tests (local only — never point at production):
# RUN_INTEGRATION=1
# TEST_MONGODB_URI=mongodb://127.0.0.1:27017/jevah_like_test
# TEST_REDIS_URL=redis://127.0.0.1:6380
# Optional tighter limits while testing 429:
# LIKE_RATE_LIMIT_PER_CONTENT=3

# Session Management
# If not set, will use JWT_SECRET
SESSION_SECRET=

# Upstash Redis (REST) - optional non-critical caches ONLY (not like hot path)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Gemini (one API key — model IDs are not separate tokens)
# Get a valid key: https://aistudio.google.com/apikey  (must start with AIza…)
# Code accepts any of these names (rotates on API_KEY_INVALID):
GOOGLE_AI_API_KEY=
# GOOGLE_GEMINI_API_KEY=
# GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-2.5-flash
GEMINI_MODERATION_MODEL=gemini-2.5-flash
GEMINI_MODERATION_ESCALATION_MODEL=gemini-2.5-flash
GEMINI_TRANSCRIPTION_MODEL=gemini-2.5-flash
GEMINI_DAILY_REQUEST_BUDGET=500
GEMINI_DAILY_INPUT_TOKEN_BUDGET=2000000
GEMINI_DAILY_OUTPUT_TOKEN_BUDGET=200000
GEMINI_REQUEST_TIMEOUT_MS=60000
GEMINI_MAX_RETRIES=2
# Distributed across API/worker processes when REDIS_URL is configured.
GEMINI_MAX_CONCURRENT=3
MODERATION_DAILY_UPLOADS_PER_USER=30
MODERATION_MAX_VIDEO_FRAMES=10
# When Gemini is down: provisional-approve strong gospel signals (default true). Set false to always quarantine.
# MODERATION_OFFLINE_PROVISIONAL_APPROVE=true
VERIFICATION_MAX_AUDIO_SEGMENTS=5
# Optional: USE_GEMINI_PRO_MODEL=true

# Content Guardian (Python sidecar — primary moderation; Gemini is gray-zone only)
# Docker Compose: http://content-guardian:8091  | Local: http://127.0.0.1:8091
CONTENT_GUARDIAN_URL=http://127.0.0.1:8091
CONTENT_GUARDIAN_TIMEOUT_MS=120000
MODERATION_FUSION_MODE=guardian_first
# Fusion thresholds (override Python defaults if needed)
# FUSION_NSFW_REJECT=0.65
# FUSION_NSFW_SAFE=0.25
# FUSION_CHRISTIAN_SCENE_APPROVE=0.55
# FUSION_GOSPEL_SCENE_APPROVE=0.55
# FUSION_GOSPEL_TEXT_STRONG=0.70
# FUSION_GOSPEL_TEXT_WEAK=0.30
# FUSION_SECULAR_SCENE_REJECT=0.55
# FUSION_SECULAR_SCENE_SAFE=0.45
# FUSION_ANTI_GOSPEL_REJECT=0.50


# Expo push notifications (https://expo.dev/accounts/[account]/settings/access-tokens)
# Required on API + worker for reliable closed-app delivery and receipt polling.
EXPO_ACCESS_TOKEN=
# Optional: receipt poll interval in worker (ms). Default 60000.
# EXPO_RECEIPT_POLL_MS=60000
# Artist release scheduler (API + worker). Default 60000.
# RELEASE_SCHEDULER_INTERVAL_MS=60000

# Cloudflare R2 (S3-compatible). Production MUST set R2_CUSTOM_DOMAIN (no r2.dev).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_CUSTOM_DOMAIN=
# Public URL path prefix (bucket keys stay unprefixed).
# Rules when unset:
#   + R2_CUSTOM_DOMAIN set → no prefix (prod custom domains usually serve bucket root)
#   + r2.dev only → jevah (…/jevah/comments/…)
# Force prefix: R2_PUBLIC_KEY_PREFIX=jevah
# Disable: R2_PUBLIC_KEY_PREFIX=
# R2_PUBLIC_KEY_PREFIX=jevah
# R2_PUBLIC_DEV_URL=https://pub-….r2.dev
# Extra allowlisted hosts for comment imageUrl (comma-separated)
# R2_ALLOWED_CDN_HOSTS=media.jevahapp.com,cdn.example.com
# Optional private staging bucket (defaults to R2_BUCKET)
# R2_STAGING_BUCKET=

# Creator track review
# Verified artists auto-approve on finalize (default true). Set false to force admin queue.
# TRACK_AUTO_APPROVE_VERIFIED=true
# Set false to skip Gemini metadata review (always under_review for unverified).
# TRACK_AI_REVIEW=true

# Comment edit window (ms). Default 24h. Set 0 for unlimited.
# COMMENT_EDIT_WINDOW_MS=86400000

# Admin report SLA (hours). Pending media reports older than this → sla.breached on detail.
# REPORT_SLA_HOURS=24

# mongodb+srv DNS override when local stub refuses SRV (Windows)
# DNS_SERVERS=8.8.8.8,1.1.1.1

# Public API URL (Contabo). Used for Swagger, share links, docs links.
# API_BASE_URL=https://api.jevahapp.com
# BACKEND_BASE_URL=https://api.jevahapp.com

# Optional keepalive (off by default — Contabo does not need Render-style cold-start pings)
# SELF_PING_ENABLED=false
# SELF_PING_URL=https://api.jevahapp.com
# SELF_PING_INTERVAL_MIN=10

