{
  "name": "Jevah-app",
  "version": "2.0.0",
  "main": "dist/app.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc && npm run copy-templates",
    "copy-templates": "node -e \"require('fs').cpSync('src/emails', 'dist/emails', {recursive: true})\"",
    "start": "node dist/index.js",
    "seed-cities": "ts-node src/scripts/seedStateCities.ts",
    "test": "jest",
    "test:engagement": "jest --testPathPattern=engagement",
    "migrate:likes": "node scripts/migrate-interaction-likes-to-like.js",
    "migrate:likes:dry": "node scripts/migrate-interaction-likes-to-like.js --dry-run",
    "heal:comment-images": "node scripts/heal-comment-image-urls.js",
    "heal:comment-images:dry": "node scripts/heal-comment-image-urls.js --dry-run",
    "heal:media-duration": "node scripts/heal-media-duration.js",
    "heal:media-duration:dry": "node scripts/heal-media-duration.js --dry-run",
    "migrate:like-indexes": "node scripts/migrate-like-indexes.js",
    "migrate:like-indexes:dry": "node scripts/migrate-like-indexes.js --dry-run",
    "reconcile:like-counts": "node scripts/reconcile-like-counts.js",
    "reconcile:like-counts:dry": "node scripts/reconcile-like-counts.js --dry-run",
    "cleanup:notification-dedupe": "node scripts/cleanup-legacy-notification-dedupe-keys.js",
    "cleanup:notification-dedupe:dry": "node scripts/cleanup-legacy-notification-dedupe-keys.js --dry-run",
    "test:integration": "jest --config jest.integration.config.js --runInBand",
    "test:scripts": "jest --runInBand --testPathPattern=scripts/__tests__",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts",
    "docs:generate": "swagger-jsdoc -d swaggerDef.js -o swagger.json",
    "docs:serve": "swagger-ui-express swagger.json",
    "test:email": "node scripts/test-email-config.js",
    "cleanup:users": "node scripts/cleanup-orphaned-users.js",
    "delete:all-users": "node scripts/delete-all-users.js",
    "seed:forums": "node scripts/seed-forum-categories.js",
    "seed:super-admin": "node scripts/seed-super-admin.js",
    "seed:polls": "node scripts/seed-polls.js",
    "seed:polls:clear": "node scripts/seed-polls.js --clear",
    "seed:copyright-free": "node scripts/seed-copyright-free-songs.js",
    "seed:copyright-free:clear": "node scripts/seed-copyright-free-songs.js --clear",
    "seed:copyright-free:upload": "node scripts/seed-copyright-free-with-upload.js",
    "seed:copyright-free:assets": "node scripts/seed-copyright-free-from-assets.js",
    "seed:new-copyright-free": "node scripts/seed-new-copyright-free-songs.js",
    "drop:old-copyright-free": "node scripts/drop-old-copyright-free-songs.js",
    "indexes:create": "node scripts/create-performance-indexes.js",
    "worker:dev": "ts-node src/workers/index.ts",
    "worker:start": "node dist/workers/index.js",
    "guardian:dev": "cd services/content-guardian && python -m uvicorn app.main:app --host 0.0.0.0 --port 8091 --reload",
    "guardian:test": "cd services/content-guardian && python -m pytest -q",
    "ranker:dev": "cd services/feed-ranker && python -m uvicorn app.main:app --host 127.0.0.1 --port 8092 --reload",
    "test:moderation-fusion": "jest --testPathPattern=gospelFusion",
    "test:feed-ranker": "jest --testPathPattern=feed/ranker",    "loadtest": "artillery run artillery.yml",
    "test:redis": "node scripts/test-redis-connection.js",
    "smoke:engagement": "node scripts/smoke-engagement.js",
    "measure:latency": "node scripts/measure-latency.js",
    "fix:like-counts": "node scripts/fix-negative-like-counts.js"
  },
  "keywords": [
    "gospel",
    "christian",
    "media",
    "streaming",
    "music",
    "videos"
  ],
  "author": "Jevah Team",
  "license": "ISC",
  "description": "A comprehensive gospel media platform with live streaming, music, videos, and community features",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.859.0",
    "@aws-sdk/s3-request-presigner": "^3.859.0",
    "@clerk/clerk-sdk-node": "^5.1.6",
    "@google/generative-ai": "^0.24.1",
    "@mux/mux-node": "^11.1.0",
    "@react-email/render": "^1.1.2",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/pdf-parse": "^1.1.5",
    "@upstash/redis": "^1.35.8",
    "axios": "^1.11.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.66.2",
    "cheerio": "^1.1.2",
    "cloudinary": "^2.6.1",
    "compression": "^1.7.4",
    "connect-redis": "^8.1.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "ejs": "^3.1.10",
    "expo-server-sdk": "^4.0.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.2.0",
    "kafkajs": "^2.2.4",
    "microsoft-cognitiveservices-speech-sdk": "^1.47.0",
    "mongoose": "^8.15.0",
    "multer": "^2.0.1",
    "nodemailer": "^7.0.3",
    "pdf-parse": "^2.2.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "resend": "^4.8.0",
    "socket.io": "^4.8.1",
    "streamifier": "^0.1.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "winston": "^3.13.0",
    "winston-daily-rotate-file": "^4.7.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.7.5",
    "@types/connect-redis": "^0.0.23",
    "@types/cors": "^2.8.17",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.2",
    "@types/express-session": "^1.18.2",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.17.1",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "@types/socket.io": "^3.0.2",
    "@types/streamifier": "^0.1.2",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "@typescript-eslint/eslint-plugin": "^7.15.0",
    "@typescript-eslint/parser": "^7.15.0",
    "artillery": "^2.0.27",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "supertest": "^7.1.4",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.3"
  }
}
