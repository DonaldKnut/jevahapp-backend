<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
  <head>
    <%- include('partials/head', { title: 'Reset Your Password - Jevah' }) %>
  </head>
  <body style="margin: 0; padding: 0; background-color: #0a1f1c;">
    <table
      role="presentation"
      width="100%"
      cellpadding="0"
      cellspacing="0"
      border="0"
      style="background-color: #0a1f1c; background: linear-gradient(160deg, #112e2a 0%, #0a1f1c 100%);"
    >
      <tr>
        <td align="center" style="padding: 32px 16px;">
          <table
            role="presentation"
            class="email-shell"
            width="560"
            cellpadding="0"
            cellspacing="0"
            border="0"
            style="
              width: 560px;
              max-width: 560px;
              background-color: #0a1f1c;
              border: 1px solid rgba(255, 107, 53, 0.22);
              border-radius: 16px;
              overflow: hidden;
            "
          >
            <tr>
              <td
                style="
                  height: 3px;
                  line-height: 3px;
                  font-size: 0;
                  background-color: #ff6b35;
                  background: linear-gradient(90deg, #ff6b35 0%, #ff8c42 50%, #f9c833 100%);
                "
              >
                &nbsp;
              </td>
            </tr>

            <%- include('partials/header', { title: 'Password Reset', subtitle: null }) %>

            <tr>
              <td
                class="email-pad"
                style="
                  padding: 12px 48px 8px 48px;
                  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
                  font-size: 16px;
                  line-height: 1.6;
                  color: #e4ebe9;
                  text-align: center;
                "
              >
                <p style="margin: 0 0 8px 0;">
                  Hi
                  <span style="color: #ff6b35; font-weight: 600;"><%= firstName %></span>,
                </p>
                <p style="margin: 0; color: #b8c4c1;">
                  We received a request to reset your password. Enter this code
                  in the app to continue.
                </p>
              </td>
            </tr>

            <tr>
              <td class="email-pad" style="padding: 28px 48px 8px 48px;">
                <table
                  role="presentation"
                  width="100%"
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                  style="
                    background-color: rgba(255, 107, 53, 0.08);
                    border: 1px solid rgba(255, 107, 53, 0.28);
                    border-radius: 14px;
                  "
                >
                  <tr>
                    <td
                      align="center"
                      class="code-text"
                      style="
                        padding: 28px 20px;
                        font-family: 'SF Mono', Monaco, Consolas, 'Courier New', monospace;
                        font-size: 34px;
                        font-weight: 700;
                        letter-spacing: 10px;
                        color: #ff6b35;
                        line-height: 1.2;
                      "
                    >
                      <%= resetCode %>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <tr>
              <td
                class="email-pad"
                style="
                  padding: 20px 48px 8px 48px;
                  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
                  font-size: 13px;
                  line-height: 1.6;
                  color: #9aa8a4;
                  text-align: center;
                "
              >
                <p style="margin: 0 0 12px 0;">
                  This code expires in
                  <strong style="color: #f9c833;">10 minutes</strong>.
                </p>
                <p style="margin: 0;">
                  If you didn’t request a reset, ignore this email — your
                  password will stay the same.
                </p>
              </td>
            </tr>

            <%- include('partials/footer') %>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
