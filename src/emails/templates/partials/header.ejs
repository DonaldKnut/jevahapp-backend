<tr>
  <td style="padding: 0; background-color: #0b1a1f;">
    <table
      role="presentation"
      width="100%"
      cellpadding="0"
      cellspacing="0"
      style="background: #0b1a1f;"
    >
      <tr>
        <td align="center" style="padding: 28px 24px 20px;">
          <img
            src="<%= typeof logoUrl !== 'undefined' && logoUrl ? logoUrl : 'https://res.cloudinary.com/bt01nio6/image/upload/v1790381597/jevahha-removebg-preview.png' %>"
            alt="Jevah"
            width="156"
            style="display: block; border: 0; outline: none; text-decoration: none; max-width: 156px; height: auto;"
          />
        </td>
      </tr>
    </table>
  </td>
</tr>
<% if (typeof title !== 'undefined' && title) { %>
<tr>
  <td
    align="center"
    class="email-pad"
    style="
      padding: 20px 48px 8px 48px;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      font-size: 26px;
      font-weight: 700;
      letter-spacing: -0.4px;
      line-height: 1.25;
      color: #ff6b35;
    "
  >
    <%= title %>
  </td>
</tr>
<% } %>
<% if (typeof subtitle !== 'undefined' && subtitle) { %>
<tr>
  <td
    align="center"
    class="email-pad"
    style="
      padding: 4px 48px 8px 48px;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      font-size: 15px;
      font-weight: 400;
      line-height: 1.5;
      color: #c8d0ce;
    "
  >
    <%= subtitle %>
  </td>
</tr>
<% } %>
