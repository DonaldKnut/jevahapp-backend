<tr>
  <td align="center" class="email-pad" style="padding: 40px 48px 8px 48px;">
    <img
      src="https://res.cloudinary.com/ddgzzjp4x/image/upload/v1755907362/jevah-hq-removebg-preview_tv9rtc.png"
      alt="Jevah"
      width="72"
      height="auto"
      style="display: block; height: 72px; width: auto; margin: 0 auto;"
    />
  </td>
</tr>
<% if (typeof title !== 'undefined' && title) { %>
<tr>
  <td
    align="center"
    class="email-pad"
    style="
      padding: 20px 48px 8px 48px;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      font-size: 26px;
      font-weight: 700;
      letter-spacing: -0.4px;
      line-height: 1.25;
      color: #ff6b35;
    "
  >
    <%= title %>
  </td>
</tr>
<% } %>
<% if (typeof subtitle !== 'undefined' && subtitle) { %>
<tr>
  <td
    align="center"
    class="email-pad"
    style="
      padding: 4px 48px 8px 48px;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      font-size: 15px;
      font-weight: 400;
      line-height: 1.5;
      color: #c8d0ce;
    "
  >
    <%= subtitle %>
  </td>
</tr>
<% } %>
